<%- include('header') %>
<h2>Events</h2>

<% if (user.role === 'member' && !member) { %>
  <p class="warn">No member profile linked to your account.</p>
<% } %>

<table>
  <tr><th>Title</th><th>Date</th><th>Location</th><th>Description</th><th>Action</th></tr>
  <% events.forEach(e => { %>
    <tr>
      <td><%= e.title %></td>
      <td><%= e.date %></td>
      <td><%= e.location %></td>
      <td><%= e.description %></td>
      <td>
        <% if (user.role === 'member' && member) { %>
          <% if (registeredEventIds.includes(e.id)) { %>
            <span class="badge badge-paid">Registered</span>
          <% } else { %>
            <form method="POST" action="/events/<%= e.id %>/register" style="display:inline">
              <button type="submit">Register</button>
            </form>
          <% } %>
        <% } %>
        <% if (['admin','board','committee'].includes(user.role)) { %>
          <a href="/admin/events/<%= e.id %>/attendees">Attendees</a>
        <% } %>
      </td>
    </tr>
  <% }) %>
</table>
<%- include('footer') %>
