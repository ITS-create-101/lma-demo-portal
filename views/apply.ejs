<%- include('header') %>
<h2>General Membership Application</h2>

<% if (success) { %>
  <p class="ok">✅ Application received. Our team will review and contact you shortly.</p>
  <p><a href="/">Back to home</a></p>
<% } else { %>

<p><em>An LMA MENA general membership is available for companies actively involved in the Leisure Marine industry with a specific marine activity on their trade license. Members receive full benefits, voting rights, and may stand for election to the board or committees.</em></p>

<form method="POST" action="/apply">

  <h3>Company Information</h3>
  <label>Company Name: <input name="company" required></label>
  <label>Trade License Number: <input name="trade_license" required></label>
  <label>Website: <input name="website"></label>
  <label>Country: <input name="country" required></label>
  <label>Industry Category: <input name="industry" required placeholder="e.g. Marina, Yacht, Services, Diving"></label>

  <h3>Primary Contact</h3>
  <label>Full Name: <input name="contact_name" required></label>
  <label>Job Title: <input name="job_title"></label>
  <label>Email: <input type="email" name="email" required></label>
  <label>Phone: <input name="phone" required></label>

  <h3>Eligibility Questions</h3>
  <label>Are you actively involved in the Leisure Marine industry?
    <select name="q_industry" required>
      <option value="">Select…</option>
      <option value="Yes">Yes</option>
      <option value="No">No</option>
    </select>
  </label>
  <label>Do you have a specific marine activity on your trade license?
    <select name="q_license" required>
      <option value="">Select…</option>
      <option value="Yes">Yes</option>
      <option value="No">No</option>
    </select>
  </label>

  <h3>Professional References</h3>
  <p><em>Please provide two industry references.</em></p>
  <label>Reference 1 — Name: <input name="ref1_name" required></label>
  <label>Reference 1 — Company: <input name="ref1_company" required></label>
  <label>Reference 1 — Email: <input type="email" name="ref1_email" required></label>
  <label>Reference 2 — Name: <input name="ref2_name" required></label>
  <label>Reference 2 — Company: <input name="ref2_company" required></label>
  <label>Reference 2 — Email: <input type="email" name="ref2_email" required></label>

  <h3>Membership Tier</h3>
  <label>Preferred tier:
    <select name="tier">
      <option>Gold</option><option>Silver</option><option>Bronze</option>
    </select>
  </label>

  <h3>Website Bio (after approval)</h3>
  <p><em>Once your membership is approved, we will add your bio to the member section of the website.</em></p>
  <label>Company Description (max 200 words):
    <textarea name="bio" rows="4"></textarea>
  </label>
  <label>Logo / Photo URL (you can upload later): <input name="logo_url"></label>

  <h3>Declaration</h3>
  <label><input type="checkbox" name="agree_articles" required> I/we agree to be bound by the Articles of Association and/or By-laws, and by any amendments made thereto, and to pay any annual subscription fees or levies as the Association shall from time to time determine.</label>
  <label><input type="checkbox" name="agree_aims" required> I/we agree to support the aims and objectives of the Association and to abide by its Rules, obligations, and Code of Practice.</label>
  <label><input type="checkbox" name="agree_understand" required> I/we understand that a breach of the rules, obligations, or Code of Practice may result in expulsion from the Association.</label>
  <label><input type="checkbox" name="agree_logo" required> I/we understand that we are not entitled to use the Association logo or indicate membership until the application is officially approved and the annual membership payment has been received.</label>
  <label><input type="checkbox" name="agree_truth" required> I/we declare that all information contained herein is true and correct.</label>

  <button type="submit">Submit Application</button>
</form>

<% } %>
<%- include('footer') %>
